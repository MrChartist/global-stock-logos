{
  "name": "@mrchartist/global-stock-logos",
  "version": "3.0.0",
  "description": "Free open-source SVG company logos for 75,000+ listed stocks across 68 markets (India, US and world), served via jsDelivr, with an optional React component.",
  "main": "logos-manifest.json",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync.js",
    "audit": "node scripts/audit.js",
    "populate:us": "node scripts/populate-us.js",
    "ingest": "node scripts/extractor.js",
    "generate": "node scripts/generator.js",
    "bulk": "node scripts/bulk-crawl.js",
    "quality": "node scripts/quality.js",
    "quality:fix": "node scripts/quality.js --fix",
    "check": "node scripts/quality.js --check",
    "test": "node scripts/quality.js --check"
  },
  "keywords": [
    "stock-logos",
    "global-stock-logos",
    "us-stocks",
    "nasdaq",
    "nyse",
    "sp500",
    "indian-stocks",
    "nse",
    "bse",
    "nifty50",
    "sensex",
    "logos",
    "fintech",
    "trading",
    "cdn",
    "company-logos",
    "svg",
    "open-source",
    "mrchartist",
    "world-markets"
  ],
  "author": "MrChartist <contact@mrchartist.com> (https://mrchartist.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrChartist/global-stock-logos.git"
  },
  "bugs": {
    "url": "https://github.com/MrChartist/global-stock-logos/issues"
  },
  "homepage": "https://github.com/MrChartist/global-stock-logos#readme",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "logos-manifest.json",
    "manifests",
    "search-index.json",
    "src",
    "LICENSE",
    "README.md",
    "DATA-SOURCES.md"
  ]
}
