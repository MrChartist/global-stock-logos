{
  "name": "@mrchartist/global-stock-logos",
  "version": "3.0.0",
  "description": "Free open-source logos and company profiles for 75,000+ listed stocks in 68 markets: SVG and PNG logos, a static JSON API (OpenAPI), a typed client and a catalogue page.",
  "main": "src/client.js",
  "type": "module",
  "scripts": {
    "test": "node scripts/quality.js --check && node scripts/validate-data.js && node scripts/validate-api.js && npm run typecheck && node scripts/test-client.js",
    "check": "node scripts/quality.js --check && node scripts/validate-data.js && node scripts/validate-api.js && npm run typecheck && node scripts/test-client.js",
    "test:client": "node scripts/test-client.js",
    "test:frontend": "node scripts/test-frontend.js",
    "typecheck": "tsc -p tsconfig.json",
    "types": "tsc -p tsconfig.types.json && cp .types/client.d.ts src/client.d.ts && rm -rf .types",
    "all": "node scripts/run-all.js",
    "sync": "node scripts/sync.js",
    "api": "node scripts/build-api.js",
    "validate": "node scripts/validate-data.js",
    "validate:api": "node scripts/validate-api.js",
    "bulk": "node scripts/bulk-crawl.js",
    "refresh": "node scripts/refresh-metadata.js",
    "enrich": "node scripts/enrich-wikidata.js",
    "registries": "node scripts/enrich-registries.js",
    "colors": "node scripts/brand-color.js",
    "png": "node scripts/render-png.js",
    "quality": "node scripts/quality.js",
    "quality:fix": "node scripts/quality.js --fix",
    "lighthouse": "node scripts/lighthouse.js"
  },
  "keywords": [
    "stock-logos",
    "global-stock-logos",
    "us-stocks",
    "nasdaq",
    "nyse",
    "sp500",
    "indian-stocks",
    "nse",
    "bse",
    "nifty50",
    "sensex",
    "logos",
    "fintech",
    "trading",
    "cdn",
    "company-logos",
    "svg",
    "open-source",
    "mrchartist",
    "world-markets",
    "api",
    "openapi",
    "company-profile",
    "market-cap",
    "json-api"
  ],
  "author": "MrChartist <contact@mrchartist.com> (https://mrchartist.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrChartist/global-stock-logos.git"
  },
  "bugs": {
    "url": "https://github.com/MrChartist/global-stock-logos/issues"
  },
  "homepage": "https://github.com/MrChartist/global-stock-logos#readme",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "api",
    "assets",
    "index.html",
    "logos-manifest.json",
    "manifests",
    "search-index.json",
    "search-index-top.json",
    "src",
    "enrichment",
    "png",
    "curated",
    "LICENSE",
    "README.md",
    "DATA-SOURCES.md",
    "docs"
  ],
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "lighthouse": "^13.5.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  },
  "types": "src/client.d.ts",
  "exports": {
    ".": {
      "types": "./src/client.d.ts",
      "default": "./src/client.js"
    },
    "./manifest": "./logos-manifest.json"
  }
}
