{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cdn.jsdelivr.net/gh/MrChartist/global-stock-logos@main/api/v1/schema/isin.schema.json","title":"ISIN pointer","description":"Points an ISIN to the company file of its primary listing. Several lines can share an ISIN (a share and its depositary receipts or cross-listings in other markets): primary is the home-market listing that is still listed, then the largest by market cap; the rest are in others, in the same order.","type":"object","required":["isin","name","primary","others"],"properties":{"isin":{"type":"string","pattern":"^[A-Z]{2}[A-Z0-9]{9}[0-9]$"},"name":{"type":"string","description":"Name of the primary listing"},"primary":{"type":"object","required":["market","ticker","exchange","status","url"],"additionalProperties":false,"properties":{"market":{"type":"string"},"ticker":{"type":"string"},"exchange":{"type":["string","null"]},"status":{"enum":["listed","delisted"]},"url":{"type":"string","format":"uri"}}},"others":{"type":"array","items":{"type":"object","required":["market","ticker","exchange","status","url"],"additionalProperties":false,"properties":{"market":{"type":"string"},"ticker":{"type":"string"},"exchange":{"type":["string","null"]},"status":{"enum":["listed","delisted"]},"url":{"type":"string","format":"uri"}}}}},"additionalProperties":false}