{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cdn.jsdelivr.net/gh/MrChartist/global-stock-logos@main/api/v1/schema/brand.schema.json","title":"Brand","description":"A consumer brand, sub-brand, product, app or subsidiary, linked to the listed company that ultimately owns it.","type":"object","required":["slug","name","aliases","kind","category","description","founded","country","parent","otherListedOwners","owners","markets","website","wikidata","brandColor","onDark","logo","sources","links"],"properties":{"slug":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"name":{"type":"string"},"aliases":{"type":"array","items":{"type":"string"},"description":"Other names people search for"},"kind":{"enum":["brand","subsidiary","product","service","app"]},"category":{"type":["string","null"]},"description":{"type":["string","null"]},"founded":{"type":["integer","null"],"description":"Year the brand was launched"},"country":{"type":["string","null"],"pattern":"^[A-Z]{2}$","description":"Country where the brand originated (ISO 3166 alpha-2)"},"parent":{"type":"object","description":"The ultimate listed owner","required":["market","ticker","url"],"properties":{"market":{"type":"string"},"ticker":{"type":"string"},"url":{"type":"string","format":"uri"}},"additionalProperties":false},"otherListedOwners":{"type":"array","items":{"type":"string"},"description":"Other listed group companies that own or sell it, as MARKET:TICKER"},"owners":{"type":"array","description":"parent first, then the other listed owners, with their API URLs","items":{"type":"object","required":["market","ticker","role","url"],"properties":{"market":{"type":"string"},"ticker":{"type":"string"},"role":{"enum":["parent","listed"]},"url":{"type":"string","format":"uri"}},"additionalProperties":false}},"markets":{"type":"array","items":{"type":"string"},"description":"Markets of its listed owners, e.g. [\"UK\", \"IN\"] for Surf Excel"},"website":{"type":["string","null"],"format":"uri"},"wikidata":{"type":["string","null"],"pattern":"^Q[0-9]+$"},"brandColor":{"type":["string","null"],"pattern":"^#[0-9A-F]{6}$"},"onDark":{"type":"boolean","description":"true = a light logo meant for dark backgrounds"},"logo":{"type":"object","required":["url","format","svg","mark","png"],"additionalProperties":false,"description":"url is the original file: vector SVG, or an official PNG of at least 1,000 px when the brand publishes no vector logo","properties":{"url":{"type":"string","format":"uri"},"format":{"enum":["svg","png"]},"svg":{"type":["string","null"],"format":"uri"},"mark":{"type":["string","null"],"format":"uri","description":"Square symbol or app icon"},"png":{"type":"object","description":"PNG URLs by pixel size (256, 512, 1024); 256 and 512 always exist, larger sizes only when the original allows (a raster is never upscaled)","required":["256","512"],"additionalProperties":{"type":"string","format":"uri"}}}},"sources":{"type":"object","required":["logo","logoType","ownership","facts","checkedAt"],"properties":{"logo":{"type":"string","format":"uri"},"logoType":{"type":"string"},"ownership":{"type":["string","null"]},"facts":{"type":["object","null"],"description":"Source URL of each fact (founded, country, headquarters, legalBasis)","additionalProperties":{"type":"string","format":"uri"}},"checkedAt":{"type":["string","null"]}},"additionalProperties":false},"links":{"type":"object","required":["self"],"properties":{"self":{"type":"string","format":"uri"}},"additionalProperties":false}},"additionalProperties":false}