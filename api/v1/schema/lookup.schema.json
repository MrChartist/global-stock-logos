{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cdn.jsdelivr.net/gh/MrChartist/global-stock-logos@main/api/v1/schema/lookup.schema.json","title":"Exchange lookup pointer","description":"Points an exchange code and ticker, as in the file name (NASDAQ-AAPL, NSE-TCS, LSE-VOD), to the company file.","type":"object","required":["key","exchange","ticker","market","name","isin","status","url"],"properties":{"key":{"type":"string","description":"EXCHANGE-TICKER, the file name without .json"},"exchange":{"type":"string"},"ticker":{"type":"string"},"market":{"type":"string"},"name":{"type":"string"},"isin":{"type":["string","null"],"pattern":"^[A-Z]{2}[A-Z0-9]{9}[0-9]$"},"status":{"enum":["listed","delisted"]},"url":{"type":"string","format":"uri"}},"additionalProperties":false}